# Database (Optional, defaults to postgres)
DB_PASSWORD=your_secure_db_password

# RabbitMQ (Optional, defaults to guest)
RABBITMQ_PASSWORD=your_secure_rabbitmq_password

# Authentication (Required)
JWT_SECRET=your_super_secret_jwt_key_32_bytes_min_length!!

# External APIs (Required)
GEMINI_API_KEY=your_gemini_api_key_here
SERVICE_API_KEY=your_service_api_key_here

# AWS Credentials (Required for cloud integrations)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
